# Non-secret settings only. Real secrets never go in a committed file.
#
# Local development (macOS): store secrets in Keychain, not here —
#   python -c "import keyring; keyring.set_password('tradalgo', 'TELEGRAM_BOT_TOKEN', '...')"
#
# GitHub Actions: set the same names below as repository secrets (Settings -> Secrets and variables ->
# Actions). tradalgo.config.KeyringStore reads an environment variable first and falls back to Keychain,
# so the workflows in .github/workflows/ can pass these straight through as env vars without any code
# change. Copy this file to `.env` for your own local notes if you like — .env is gitignored and is not
# read by the app itself (it uses Keychain/env directly, not python-dotenv).
#
# FYERS_APP_ID=
# FYERS_SECRET_KEY=
# FYERS_PIN=
# FYERS_REFRESH_TOKEN=      # from `tradalgo login` (one-time browser login; valid ~15 days)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

TRADALGO_CONFIG=config.yaml
